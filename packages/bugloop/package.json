{
  "name": "bugloop",
  "version": "0.1.1",
  "description": "A \"Report a problem\" button that also reports failed requests and uncaught errors automatically, triages them, opens GitHub issues and suggests fixes as reviewable PRs. Setup: npx bugloop init",
  "license": "MIT",
  "homepage": "https://github.com/Canzz0/patchback#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Canzz0/patchback.git",
    "directory": "packages/bugloop"
  },
  "bugs": {
    "url": "https://github.com/Canzz0/patchback/issues"
  },
  "type": "module",
  "bin": {
    "bugloop": "dist/cli.js"
  },
  "exports": {
    "./widget": {
      "types": "./dist/types/widget/index.d.ts",
      "default": "./dist/widget.js"
    },
    "./next": {
      "types": "./dist/types/next.d.ts",
      "default": "./dist/next.js"
    },
    "./server": {
      "types": "./dist/types/server/index.d.ts",
      "default": "./dist/server.js"
    },
    "./bugloop.global.js": "./dist/bugloop.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/package-readme.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "yaml": "^2.6.0",
    "zod": "^3.23.8",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "bug-report",
    "feedback",
    "widget",
    "github",
    "triage",
    "nextjs",
    "autofix",
    "error-reporting",
    "bug-tracker",
    "next",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  }
}
