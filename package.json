{
  "name": "glitchback-monorepo",
  "private": true,
  "description": "Glitchback monorepo: tek paket packages/glitchback (npm: glitchback)",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w glitchback",
    "typecheck": "tsc -p packages/glitchback",
    "test": "node --test --experimental-strip-types packages/glitchback/test/*.test.ts",
    "glitchback": "node packages/glitchback/dist/cli.js",
    "serve": "node packages/glitchback/dist/cli.js serve"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
